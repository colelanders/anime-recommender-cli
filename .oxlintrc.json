{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": ["dist", "node_modules"]
}
